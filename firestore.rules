rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WEBSITE RULES FRAGMENT.
    // This shared Firebase project also serves other applications. This file is
    // intentionally not referenced by firebase.json: merge these matches into
    // the project's complete ruleset before deploying it.
    function isWebsiteEditor() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/user-roles/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/user-roles/$(request.auth.uid)
        ).data.websiteEditor == true;
    }

    function validOrderCreate() {
      return request.resource.data.keys().hasOnly([
          'customer', 'items', 'total', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'customer', 'items', 'total', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasOnly([
          'name', 'email', 'phone', 'address'
        ])
        && request.resource.data.customer.keys().hasAll([
          'name', 'email', 'phone', 'address'
        ])
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() > 0
        && request.resource.data.customer.name.size() <= 120
        && request.resource.data.customer.email is string
        && request.resource.data.customer.email.size() <= 254
        && request.resource.data.customer.email.matches(
          '^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'
        )
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() <= 40
        && request.resource.data.customer.address is string
        && request.resource.data.customer.address.size() <= 500
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 1000000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    // Roles are server-written by lec-mishenah-admin. The website only needs
    // to read the signed-in user's own role document to gate its UI.
    match /user-roles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // CMS content: public site reads; website editors write.
    match /content/{sectionId} {
      allow read: if true;
      allow write: if isWebsiteEditor();
    }

    // Merch products: public storefront reads; website editors write.
    match /merch_products/{productId} {
      allow read: if true;
      allow write: if isWebsiteEditor();
    }

    // Checkout remains public, with a bounded schema. Order data contains PII,
    // so only website editors can read or modify it. hasOnly() plus the
    // required pending status prevents clients from supplying paid flags or
    // pre-marking an order as paid.
    match /merch_orders/{orderId} {
      allow create: if validOrderCreate();
      allow read, update, delete: if isWebsiteEditor();
    }

    // Merch config: public storefront reads; website editors write.
    match /merch_config/{docId} {
      allow read: if true;
      allow write: if isWebsiteEditor();
    }
  }
}
