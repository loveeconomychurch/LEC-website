rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WEBSITE RULES FRAGMENT.
    // This shared Firebase project also serves other applications. This file is
    // intentionally not referenced by firebase.json: merge these matches into
    // the project's complete ruleset before deploying it.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validOrderCreate() {
      return request.resource.data.keys().hasOnly([
          'customer', 'items', 'total', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'customer', 'items', 'total', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasOnly([
          'name', 'email', 'phone', 'address'
        ])
        && request.resource.data.customer.keys().hasAll([
          'name', 'email', 'phone', 'address'
        ])
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() > 0
        && request.resource.data.customer.name.size() <= 120
        && request.resource.data.customer.email is string
        && request.resource.data.customer.email.size() <= 254
        && request.resource.data.customer.email.matches(
          '^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'
        )
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() <= 40
        && request.resource.data.customer.address is string
        && request.resource.data.customer.address.size() <= 500
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 1000000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    // Admin records must be provisioned outside the website. A user can only
    // read their own record, and no client can create or alter one.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // CMS content: public site reads; website administrators write.
    match /content/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Merch products: public storefront reads; administrators write.
    match /merch_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Checkout remains public, with a bounded schema. Order data contains PII,
    // so only website administrators can read or modify it.
    match /merch_orders/{orderId} {
      allow create: if validOrderCreate();
      allow read, update, delete: if isAdmin();
    }

    // Merch config: public storefront reads; administrators write.
    match /merch_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
