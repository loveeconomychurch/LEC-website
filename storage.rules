rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/admins/$(request.auth.uid)
        );
    }

    // WEBSITE RULES FRAGMENT. Like firestore.rules, this must be merged into
    // the shared project's complete ruleset and is not directly deployable.
    match /cms/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
